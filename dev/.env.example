DATABASE_URL=mongodb://127.0.0.1/payload-keycloak
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public origin of this app; used for redirect URIs and the cookie CSRF allow-list
SERVER_URL=http://localhost:3000
# Next.js basePath, empty unless the app is mounted under a sub-path
BASE_PATH=

# Keycloak base URL without the realm
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=payload
# Public client with Standard flow and PKCE S256
KEYCLOAK_CLIENT_ID=payload
# Userinfo claim holding nested boolean permissions
KEYCLOAK_PERMISSIONS_CLAIM=permissions
